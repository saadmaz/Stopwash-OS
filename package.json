{
  "name": "stopwash-pos",
  "private": true,
  "version": "0.1.0",
  "description": "Point-of-sale and operations system for STOPWASH car wash",
  "author": "Saad Mazhar",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"!@stopwash/firebase\" test",
    "test:rules": "pnpm --filter @stopwash/firebase test",
    "e2e": "pnpm --filter @stopwash/web e2e",
    "emulators": "docker compose up emulators",
    "seed": "pnpm --filter @stopwash/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
