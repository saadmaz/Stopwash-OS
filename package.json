{
  "name": "stopwash-os",
  "version": "0.3.1",
  "description": "Point-of-sale and operations platform for STOPWASH: orders, queue, checkout, shifts, payroll and reports in English, Sinhala and Tamil.",
  "homepage": "https://github.com/saadmaz/Stopwash-OS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadmaz/Stopwash-OS.git"
  },
  "bugs": {
    "url": "https://github.com/saadmaz/Stopwash-OS/issues"
  },
  "author": "Saad Mazhar (https://github.com/saadmaz)",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter \"!@stopwash/firebase\" test",
    "test:rules": "pnpm --filter @stopwash/firebase test",
    "test:e2e": "pnpm --filter @stopwash/web e2e",
    "emulators": "docker compose up emulators"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
