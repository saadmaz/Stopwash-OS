# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_PRETTY=true
# memory (default) or firestore (stub until Firebase is wired up)
DATA_BACKEND=memory
# Development only: seed demo staff and a counter device into the in-memory store
DEV_SEED=true
DEV_DEVICE_ID=dev-counter
DEV_DEVICE_SECRET=dev-counter-secret-change-me
# Emulators only. A demo- project id can never reach a real Firebase project.
FIREBASE_PROJECT_ID=demo-stopwash
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Sign-in tokens. dev = signed JWT; firebase = custom tokens (stub until Firebase is configured)
AUTH_ISSUER=dev
# At least 32 random characters, e.g. from: openssl rand -hex 32
AUTH_DEV_SECRET=replace-with-32-plus-random-characters-000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_BRAND_ID=stopwash
# Production only: path to a service-account key file kept outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
